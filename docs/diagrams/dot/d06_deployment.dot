digraph G { graph [fontname="DejaVu Sans",fontsize=12,pad=0.2,nodesep=0.25,ranksep=0.4,newrank=true]; node [fontname="DejaVu Sans",fontsize=11,shape=box,style="rounded,filled",fillcolor="#f4f6f8",color="#44546a"]; edge [fontname="DejaVu Sans",fontsize=10,color="#44546a"]; rankdir=TB; compound=true;
subgraph cluster_dev { label="Local dev / CI"; style="rounded,dashed"; color="#475569"; fontcolor="#475569"; Dev[label="Docker Compose: Postgres, object-store\nemulator, queue; synthetic seed data",fillcolor="#ecfccb",color="#3f6212"]; CI[label="CI runners (ephemeral,\nno production secrets)",fillcolor="#ecfccb",color="#3f6212"]; }
subgraph cluster_stg { label="Staging (production-like, synthetic data only)"; style="rounded,dashed"; color="#475569"; fontcolor="#475569"; S1[label="Investigative staging\nown network, IdP tenant, secrets",fillcolor="#ffedd5",color="#9a3412"]; S2[label="Personal relay staging",fillcolor="#dbeafe",color="#1e40af"]; {rank=same; S1; S2} }
subgraph cluster_prp { label="Production: Personal"; style="rounded,dashed"; color="#1e40af"; fontcolor="#1e40af"; PR[label="Relay service",fillcolor="#dbeafe",color="#1e40af"]; PB[label="Ciphertext blob store",fillcolor="#dbeafe",color="#1e40af"]; PD[label="Relay metadata DB (minimal)",fillcolor="#dbeafe",color="#1e40af"]; {rank=same; PB; PD} }
subgraph cluster_pri { label="Production: Investigative (separate account / project)"; style="rounded,dashed"; color="#9a3412"; fontcolor="#9a3412"; IA[label="API + workers",fillcolor="#ffedd5",color="#9a3412"]; IDB[label="PostgreSQL\nprimary + backups",fillcolor="#ffedd5",color="#9a3412"]; IOS[label="Object store\n(versioned, retention)",fillcolor="#ffedd5",color="#9a3412"]; KMS[label="KMS / secrets",fillcolor="#ffedd5",color="#9a3412"]; MON[label="Monitoring +\naudit sink",fillcolor="#ffedd5",color="#9a3412"]; {rank=same; IDB; IOS} {rank=same; KMS; MON} }
BK[label="Backups in a separate failure domain",fillcolor="#f3f4f6",color="#6b7280",style="rounded,dashed,filled"];
Dev->CI; CI->S1; CI->S2; S2->PR [label=" promote"]; PR->PB; PR->PD; S1->IA [label=" promote"]; IA->IDB; IA->IOS; IDB->KMS [style=invis]; IOS->MON [style=invis]; IA->KMS [constraint=false]; IA->MON [constraint=false]; IDB->BK; IOS->BK; PD->IA [style=invis];
}