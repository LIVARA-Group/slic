digraph G { graph [fontname="DejaVu Sans",fontsize=12,pad=0.2,nodesep=0.25,ranksep=0.4,newrank=true]; node [fontname="DejaVu Sans",fontsize=11,shape=box,style="rounded,filled",fillcolor="#f4f6f8",color="#44546a"]; edge [fontname="DejaVu Sans",fontsize=10,color="#44546a"]; rankdir=TB; node[shape=box,fillcolor="#dbeafe",color="#1e40af"];
Src[label="Source Artifact\n(immutable snapshot)"]; At[label="Attachment (blob)"]; Nt[label="Note\n(+ revisions)"]; Obs[label="Observation\n(locator)"]; Cl[label="Claim\nassessment · review · origin"]; Hy[label="Hypothesis\nassumptions · falsifiers"]; De[label="Decision"]; Ac[label="Action"]; Ev[label="Event\n(real-world)"]; En[label="Entity\n(+ aliases, identifiers)"]; Co[label="Collection / Project"]; Rl[label="Relation\n(typed by Predicate)"]; Rv[label="Revision (immutable)"]; Pv[label="Activity · Agent ·\nProvenance link"]; Ap[label="AI Proposal\n(staging only)",fillcolor="#fde68a",color="#92400e"]; Rr[label="Review event"];
At->Src [label=" bytes of"]; Nt->Src [label=" frozen rev",style=dashed]; Src->Obs [label=" observed in"]; Obs->Cl [label=" evidence\n (polarity)"]; Cl->Hy [label=" role"]; Hy->De [label=" considered by"]; De->Ac;
Cl->En [label=" subject / object"]; Ev->En [label=" participants"]; Co->En [label=" members",style=dashed]; Rl->En [label=" endpoints",style=dashed];
Ap->Rr [label=" accept / edit"]; Rr->Cl [label=" creates canonical"]; Pv->Cl [style=dashed,label=" derivation"]; Rv->Nt [style=dashed,label=" history of any\n versioned object"];
}