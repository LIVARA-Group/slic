digraph G { graph [fontname="DejaVu Sans",fontsize=12,pad=0.2,nodesep=0.25,ranksep=0.4,newrank=true]; node [fontname="DejaVu Sans",fontsize=11,shape=box,style="rounded,filled",fillcolor="#f4f6f8",color="#44546a"]; edge [fontname="DejaVu Sans",fontsize=10,color="#44546a"]; rankdir=TB; node[fillcolor="#dbeafe",color="#1e40af"];
L[label="Local change detected\n(outbox row in same transaction)"]; E[label="Build envelope:\nencrypt + AAD + content hash"]; U[label="Upload (idempotent by envelope id)"]; R[label="Relay: authenticate device,\nstore ciphertext, assign cursor"]; D[label="Remote device: discover (cursor)"]; DL[label="Download"]; DEC[label="Decrypt + verify AAD/hash"]; VAL[label="Validate schema + domain invariants"]; M[label="Merge by data class",shape=diamond]; ACK[label="Acknowledge + advance cursor"]; CF[label="Conflict → user decision",fillcolor="#fde68a"]; CP[label="Compaction (key-epoch aware)"];
L->E->U->R->D->DL->DEC->VAL->M; M->ACK [label="auto-mergeable"]; M->CF [label="needs decision"]; CF->ACK; ACK->CP [style=dashed]; DEC->R [label="replay/invalid → reject",style=dashed,color="#b91c1c"];
}