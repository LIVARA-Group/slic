digraph G { graph [fontname="DejaVu Sans",fontsize=12,pad=0.2,nodesep=0.25,ranksep=0.4,newrank=true]; node [fontname="DejaVu Sans",fontsize=11,shape=box,style="rounded,filled",fillcolor="#f4f6f8",color="#44546a"]; edge [fontname="DejaVu Sans",fontsize=10,color="#44546a"]; rankdir=TB;
U1[label="Individual user\n(Personal owner)",shape=ellipse,fillcolor="#dbeafe",color="#1e40af"]; U2[label="Analyst / Supervisor /\nCustodian / Auditor",shape=ellipse,fillcolor="#ffedd5",color="#9a3412"]; U3[label="Platform administrator",shape=ellipse,fillcolor="#ffedd5",color="#9a3412"];
S[label="SLIC\n(two contours, separate trust models)",shape=box,fillcolor="#e0e7ff",color="#3730a3",penwidth=2];
E1[label="Identity provider /\npasskey authenticators",fillcolor="#f3f4f6",color="#6b7280",style="rounded,dashed,filled"]; E2[label="AI model providers\n(local, hosted, air-gapped tiers)",fillcolor="#f3f4f6",color="#6b7280",style="rounded,dashed,filled"]; E3[label="External sources\n(web, files, registries)",fillcolor="#f3f4f6",color="#6b7280",style="rounded,dashed,filled"]; E4[label="Time-stamp authority /\nwitness (optional, ADR-009)",fillcolor="#f3f4f6",color="#6b7280",style="rounded,dashed,filled"]; E5[label="Object storage / cloud\n(provider TBD, ADR-022)",fillcolor="#f3f4f6",color="#6b7280",style="rounded,dashed,filled"];
U1->S; U2->S; U3->S [label="operate, no implicit plaintext"]; S->E1; S->E2 [label="policy-gated"]; E3->S [label="capture / ingest"]; S->E4; S->E5;
}