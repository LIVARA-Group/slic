digraph G { graph [fontname="DejaVu Sans",fontsize=12,pad=0.2,nodesep=0.25,ranksep=0.4,newrank=true]; node [fontname="DejaVu Sans",fontsize=11,shape=box,style="rounded,filled",fillcolor="#f4f6f8",color="#44546a"]; edge [fontname="DejaVu Sans",fontsize=10,color="#44546a"]; rankdir=TB; node[shape=box];
subgraph cluster_tb1 { label="TB1 Device (trusted only while unlocked)"; style="rounded,dashed"; color="#1e40af"; fontcolor="#1e40af"; Br[label="Browser UI",fillcolor="#dbeafe",color="#1e40af"]; LS[label="Local storage\n(plaintext unless OQ-11)",fillcolor="#dbeafe",color="#1e40af"]; WK[label="Workers / crypto",fillcolor="#dbeafe",color="#1e40af"];  }
subgraph cluster_tb2 { label="TB2 Personal relay (honest-but-curious)"; style="rounded,dashed"; color="#475569"; fontcolor="#475569"; RL[label="Relay",fillcolor="#f3f4f6",color="#6b7280",style="rounded,dashed,filled"]; BS[label="Blob store",fillcolor="#f3f4f6",color="#6b7280",style="rounded,dashed,filled"]; }
subgraph cluster_tb3 { label="TB3 Investigative service"; style="rounded,dashed"; color="#9a3412"; fontcolor="#9a3412"; API[label="API",fillcolor="#ffedd5",color="#9a3412"]; DB[label="PostgreSQL",fillcolor="#ffedd5",color="#9a3412"]; OS[label="Object store",fillcolor="#ffedd5",color="#9a3412"];  }
subgraph cluster_tb4 { label="TB4 Untrusted-content processing"; style="rounded,dashed"; color="#b91c1c"; fontcolor="#b91c1c"; PW[label="Parser worker",fillcolor="#fecaca",color="#b91c1c"]; ML[label="AI model + retrieved context",fillcolor="#fecaca",color="#b91c1c"];  }
Br->LS; Br->WK; WK->RL [label=" ciphertext + minimal metadata"]; RL->BS; BS->API [style=invis]; Br->API [label=" TLS + authN + case scope"]; API->DB [label=" least-priv role, RLS"]; API->OS [label=" signed access"]; API->PW [label=" bytes only"]; PW->API [label=" validated output",constraint=false]; API->ML [label=" authorised context only"]; ML->API [label=" proposals only",constraint=false];
}