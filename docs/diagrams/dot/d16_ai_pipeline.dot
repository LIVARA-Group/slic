digraph G { graph [fontname="DejaVu Sans",fontsize=12,pad=0.2,nodesep=0.25,ranksep=0.4,newrank=true]; node [fontname="DejaVu Sans",fontsize=11,shape=box,style="rounded,filled",fillcolor="#f4f6f8",color="#44546a"]; edge [fontname="DejaVu Sans",fontsize=10,color="#44546a"]; rankdir=TB;
node[fillcolor="#dbeafe",color="#1e40af"]; Rq[label="User request"]; Ic[label="Intent classification"]; Cs[label="Context selection"]; Pc[label="Permission + data-tier check\n(deterministic code)",fillcolor="#fed7aa"]; Rt[label="Retrieval (filters BEFORE ranking)"]; Ca[label="Context assembly\n(untrusted content delimited)"]; Mr[label="Model routing"]; Mx[label="Model execution"]; Ov[label="Output validation\n(schema, locators, policy)"]; Pg[label="Proposal generation (staging)",fillcolor="#fde68a"]; Hr[label="Human review"]; Ec[label="Explicit commit\n(canonical object + review event + provenance)"];
Rq->Ic->Cs->Pc->Rt->Ca->Mr->Mx->Ov->Pg->Hr->Ec; Ov->Pg [style=invis]; Pc->Rq [label="deny",style=dashed,color="#b91c1c"];
}