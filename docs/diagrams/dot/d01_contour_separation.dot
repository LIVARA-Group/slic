digraph G { graph [fontname="DejaVu Sans",fontsize=12,pad=0.2,nodesep=0.25,ranksep=0.4,newrank=true]; node [fontname="DejaVu Sans",fontsize=11,shape=box,style="rounded,filled",fillcolor="#f4f6f8",color="#44546a"]; edge [fontname="DejaVu Sans",fontsize=10,color="#44546a"]; rankdir=TB; compound=true;
subgraph cluster_p { label="PERSONAL CONTOUR (user-sovereign)"; style="rounded,dashed"; color="#1e40af"; fontcolor="#1e40af"; P_UI[label="Personal web app (React/TS)",fillcolor="#dbeafe",color="#1e40af"]; P_DB[label="Local store\n(engine: ADR-004)",fillcolor="#dbeafe",color="#1e40af"]; P_IDX[label="Local indexes\n(derived)",fillcolor="#dbeafe",color="#1e40af"]; P_KEY[label="Vault keys\n(device + recovery)",fillcolor="#dbeafe",color="#1e40af"]; P_SYNC[label="Sync relay\n(ciphertext only)",fillcolor="#dbeafe",color="#1e40af"]; {rank=same; P_DB; P_IDX} {rank=same; P_KEY; P_SYNC} }
subgraph cluster_i { label="INVESTIGATIVE CONTOUR (organisation-governed)"; style="rounded,dashed"; color="#9a3412"; fontcolor="#9a3412"; I_UI[label="Investigative web app",fillcolor="#ffedd5",color="#9a3412"]; I_API[label="Investigative API\n(modular monolith)",fillcolor="#ffedd5",color="#9a3412"]; I_DB[label="PostgreSQL\n(RLS, audit)",fillcolor="#ffedd5",color="#9a3412"]; I_OBJ[label="Evidence\nobject store",fillcolor="#ffedd5",color="#9a3412"]; I_W[label="Sandboxed\nparser workers",fillcolor="#ffedd5",color="#9a3412"]; I_AUD[label="Audit chain +\ncheckpoints",fillcolor="#ffedd5",color="#9a3412"]; {rank=same; I_DB; I_OBJ} {rank=same; I_W; I_AUD} }
SHARED[label="Shared: pure vocabulary types, UI components, validators\n(no identity, keys, storage or audit)",fillcolor="#ecfccb",color="#3f6212"];
X[label="Cross-contour transfer: DEFERRED (PRD-012)\nexplicit, authorised, logged, reviewed",fillcolor="#f3f4f6",color="#6b7280",style="rounded,dashed,filled"];
P_UI->P_DB; P_UI->P_IDX; P_DB->P_KEY [style=invis]; P_UI->P_KEY [style=dashed,arrowhead=none]; P_IDX->P_SYNC [label=" TLS, E2EE"];
I_UI->I_API; I_API->I_DB; I_API->I_OBJ; I_DB->I_W [style=invis]; I_OBJ->I_AUD [style=invis]; I_API->I_W; I_API->I_AUD;
P_DB->X [style=dashed,color="#b91c1c",label=" no implicit path",fontcolor="#b91c1c"]; X->I_UI [style=dashed,color="#b91c1c"];
SHARED->P_UI [style=dotted,arrowhead=none]; SHARED->I_UI [style=dotted,arrowhead=none];
}