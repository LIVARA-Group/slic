digraph G { graph [fontname="DejaVu Sans",fontsize=12,pad=0.2,nodesep=0.25,ranksep=0.4,newrank=true]; node [fontname="DejaVu Sans",fontsize=11,shape=box,style="rounded,filled",fillcolor="#f4f6f8",color="#44546a"]; edge [fontname="DejaVu Sans",fontsize=10,color="#44546a"]; rankdir=TB;
subgraph cluster_p { label="Personal deployment"; style="rounded,dashed"; color="#1e40af"; fontcolor="#1e40af"; PW[label="Personal web client\nReact + TypeScript (Vite)",fillcolor="#dbeafe",color="#1e40af"]; PWK[label="Workers: storage · search\ncrypto · parse",fillcolor="#dbeafe",color="#1e40af"]; PST[label="Local persistence\nIndexedDB | SQLite-WASM+OPFS",fillcolor="#dbeafe",color="#1e40af"]; PRL[label="Sync relay (optional)\n+ ciphertext blob store",fillcolor="#dbeafe",color="#1e40af"]; }
subgraph cluster_i { label="Investigative deployment (separate accounts, networks, secrets)"; style="rounded,dashed"; color="#9a3412"; fontcolor="#9a3412"; IW[label="Investigative\nweb client",fillcolor="#ffedd5",color="#9a3412"]; IA[label="API (NestJS modular monolith)\nauthorization in domain services",fillcolor="#ffedd5",color="#9a3412"]; IQ[label="Job queue",fillcolor="#ffedd5",color="#9a3412"]; IP[label="Parser workers\n(sandbox)",fillcolor="#ffedd5",color="#9a3412"]; IDB[label="PostgreSQL",fillcolor="#ffedd5",color="#9a3412"]; IO[label="Object store\n(evidence, exports)",fillcolor="#ffedd5",color="#9a3412"]; IAI[label="AI gateway\n(tiered)",fillcolor="#ffedd5",color="#9a3412"]; }
PW->PWK; PWK->PST; PW->PRL [label=" HTTPS"]; IW->IA [label=" HTTPS"]; IA->IDB; IA->IO; IA->IQ; IQ->IP; IP->IO [label=" derivatives"]; IA->IAI; PW->IW [style=invis];
}