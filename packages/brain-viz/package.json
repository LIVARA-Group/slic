{
  "name": "@repo/brain-viz",
  "version": "0.1.0",
  "description": "Renderer-neutral graph export and standalone HTML map for @repo/brain",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "assets", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "export": "tsx scripts/export.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@repo/brain": "workspace:*",
    "@repo/brain-sim": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
