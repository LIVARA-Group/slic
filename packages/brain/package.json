{
  "name": "@repo/brain",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "docs"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./anatomy": {
      "types": "./dist/anatomy/index.d.ts",
      "import": "./dist/anatomy/index.js"
    },
    "./connectome": {
      "types": "./dist/connectome/index.d.ts",
      "import": "./dist/connectome/index.js"
    },
    "./cognition": {
      "types": "./dist/cognition/index.d.ts",
      "import": "./dist/cognition/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "import": "./dist/graph/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "^5.1.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
