# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=log
# Comma-separated list. Not needed when the web app uses the Vite/Caddy proxy (same origin).
CORS_ORIGIN=http://localhost:5173
# Used by docker-compose.yml (local Postgres) and docker-compose.prod.yml
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=app
DATABASE_URL=postgres://app:change-me-locally@localhost:5432/app
